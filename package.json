{
  "name": "vite-tailwind4-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src/js/main.js vite.config.js --no-config-lookup --global document --rule \"no-undef:error\" --rule \"no-unused-vars:error\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite --host 127.0.0.1",
    "verify": "npm run lint && npm run build"
  },
  "dependencies": {
    "tailwindcss": "^4.0.0-alpha.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.0.0",
    "vite": "^6.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
