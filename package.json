{
  "name": "vite-tailwind4-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5127 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5127 --strictPort",
    "preview:test": "vite preview --host 127.0.0.1 --port 5128 --strictPort",
    "start": "vite --host 127.0.0.1 --port 5127 --strictPort",
    "format": "prettier --write .",
    "prettier": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test --config=playwright.production.config.js",
    "test:e2e:ui": "playwright test --ui",
    "test:vue-audit": "node --test tests/vue-audit.test.js",
    "sonar": "sonar-scanner",
    "verify": "npm run lint && npm run build && npm run test:e2e -- --reporter=line"
  },
  "dependencies": {
    "tailwindcss": "^4.0.0-alpha.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0-alpha.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^15.12.0",
    "playwright": "^1.49.1",
    "prettier": "^3.9.8",
    "sonar-scanner": "^3.0.0",
    "vite": "^6.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
